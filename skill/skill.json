{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "summary": "CookAlong TV - hands-free, ingredient-aware step-by-step cooking on Fire TV and Alexa, with smart swaps and dietary safety.",
          "examplePhrases": [
            "Alexa, open cook along",
            "Alexa, ask cook along what I can make with chicken and rice",
            "Alexa, tell cook along I'm vegan",
            "Alexa, ask cook along to cook creamy mushroom risotto",
            "Alexa, tell cook along I don't have parmesan"
          ],
          "keywords": ["cooking", "recipes", "fire tv", "timer", "alexa", "apl", "substitutions", "dietary"]
        }
      },
      "isAvailableWorldwide": true,
      "category": "FOOD_AND_DRINK",
      "distributionCountries": []
    },
    "apis": {
      "custom": {
        "endpoint": {
          "sourceDir": "."
        },
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              { "mode": "TV", "shape": "RECTANGLE", "minWidth": 1920, "maxWidth": 1920, "minHeight": 1080, "maxHeight": 1080 },
              { "mode": "HUB", "shape": "RECTANGLE", "minWidth": 1024, "maxWidth": 1280, "minHeight": 600, "maxHeight": 800 },
              { "mode": "HUB", "shape": "ROUND", "minWidth": 480, "maxWidth": 480, "minHeight": 480, "maxHeight": 480 }
            ]
          }
        ]
      }
    },
    "permissions": [],
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "isExportCompliant": true,
      "containsAds": false,
      "isChildDirected": false,
      "usesPersonalInfo": true
    }
  }
}
