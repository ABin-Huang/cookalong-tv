{
  "type": "APL",
  "version": "1.9",
  "theme": "dark",
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Frame",
        "id": "matchRoot",
        "width": "100%",
        "height": "100%",
        "backgroundColor": "#0b0f14",
        "paddingLeft": 72,
        "paddingRight": 72,
        "paddingTop": 56,
        "item": {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "items": [
            {
              "type": "Text",
              "text": "${payload.cookalongData.properties.title}",
              "fontSize": 34,
              "fontWeight": 400,
              "color": "#ff8c42",
              "letterSpacing": 1.2
            },
            {
              "type": "Text",
              "text": "${payload.cookalongData.properties.subtitle}",
              "fontSize": 52,
              "fontWeight": 700,
              "color": "#ffffff",
              "maxLines": 1,
              "spacing": 8
            },
            {
              "type": "Text",
              "text": "${payload.cookalongData.properties.profileNote}",
              "fontSize": 24,
              "color": "#9fb0c0",
              "spacing": 6,
              "when": "${payload.cookalongData.properties.profileNote != ''}"
            },
            {
              "type": "Container",
              "data": "${payload.cookalongData.properties.matches}",
              "width": "100%",
              "spacing": 18,
              "marginTop": 28,
              "items": [
                {
                  "type": "Frame",
                  "width": "100%",
                  "height": 132,
                  "borderRadius": 18,
                  "borderWidth": 4,
                  "borderColor": "${data.best ? '#ff8c42' : '#26303c'}",
                  "backgroundColor": "${data.best ? '#1c2330' : '#141a22'}",
                  "paddingLeft": 32,
                  "paddingRight": 32,
                  "item": {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "center",
                    "width": "100%",
                    "height": "100%",
                    "items": [
                      {
                        "type": "Text",
                        "text": "${data.score}%",
                        "fontSize": 56,
                        "fontWeight": 700,
                        "color": "${data.score >= 80 ? '#46d188' : (data.score >= 50 ? '#ffb703' : '#8a98a8')}",
                        "width": 150
                      },
                      {
                        "type": "Container",
                        "width": "70%",
                        "items": [
                          {
                            "type": "Text",
                            "text": "${data.rank}. ${data.name}",
                            "fontSize": 40,
                            "fontWeight": 700,
                            "color": "#ffffff",
                            "maxLines": 1
                          },
                          {
                            "type": "Text",
                            "text": "${data.meta}",
                            "fontSize": 24,
                            "color": "#9fb0c0",
                            "spacing": 4
                          }
                        ]
                      },
                      {
                        "type": "Text",
                        "text": "${data.status}",
                        "fontSize": 24,
                        "fontWeight": 600,
                        "color": "${data.ready ? '#46d188' : '#c9b3f5'}",
                        "textAlign": "end",
                        "grow": 1
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "Text",
              "text": "Say “cook it” for the best match, or “what else”.",
              "fontSize": 26,
              "color": "#78889a",
              "spacing": 34
            }
          ]
        }
      }
    ]
  }
}
